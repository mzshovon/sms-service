APP_ENV=local
API_AUTH_ENABLED=true
API_CLIENT_ID=replace-with-client-id
API_CLIENT_PASSWORD=replace-with-client-password
SMS_SEND_RATE_LIMIT_REQUESTS=30
SMS_SEND_RATE_LIMIT_WINDOW_SECONDS=60
SMS_API_BASE_URL=https://provider.example.com
SMS_SEND_PATH=/api/sms/send
SMS_DLR_PATH=/api/sms/dlr
SMS_API_KEY=replace-with-provider-api-key
SMS_SENDER_ID=replace-with-provider-sender-id
SMS_SENDER_NAME=replace-with-provider-sender-name
SMS_TIMEOUT_SECONDS=10
PORT=8000
